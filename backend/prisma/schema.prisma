generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  location     String?
  occupation   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions Transaction[]
  receiptScans ReceiptScan[]
}

model Category {
  id           String          @id @default(cuid())
  name         String
  type         CategoryType
  createdAt    DateTime        @default(now())

  transactions Transaction[]
  categoryBudgets CategoryBudget[]
}

model CategoryBudget {
  id        String   @id @default(cuid())
  amount    Float
  month     Int
  year      Int
  categoryId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category  Category @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, month, year])
}

model Transaction {
  id          String   @id @default(cuid())
  amount      Float
  description String?
  date        DateTime @default(now())
  type        TransactionType
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  categoryId  String

  user        User     @relation(fields: [userId], references: [id])
  category    Category @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([categoryId])
  @@index([date])
}

model ReceiptScan {
  id            String            @id @default(cuid())
  userId        String?
  merchant      String?
  date          String?
  time          String?
  address       String?
  phone         String?
  website       String?
  receiptNumber String?
  paymentMethod String?
  category      String?
  amount        Float?
  rawText       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user          User?             @relation(fields: [userId], references: [id])
  items         ReceiptScanItem[]
}

model ReceiptScanItem {
  id            String      @id @default(cuid())
  receiptScanId String
  name          String?
  quantity      String?
  unitPrice     String?
  lineTotal     String?
  createdAt     DateTime    @default(now())

  receiptScan   ReceiptScan @relation(fields: [receiptScanId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  icon      String?
  read      Boolean  @default(false)
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([deleted])
}

model Budget {
  id        String   @id @default(cuid())
  amount    Float
  month     Int
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, year])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum CategoryType {
  INCOME
  EXPENSE
}